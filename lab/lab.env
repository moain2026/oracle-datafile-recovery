# Oracle lab settings (edit, then run scripts/up). Pin the image: never use "latest".
# Default: official Oracle AI Database 26ai Free (Full) from container-registry.oracle.com.
# Record the digest you actually pulled in out/golden/<run>/meta/image.txt (export_golden does it).
ODR_IMAGE=container-registry.oracle.com/database/free:23.26.0.0
ODR_CONTAINER=odr-oracle
ODR_PORT=1521
# Lab-only password (letters+digits). Never reuse elsewhere.
ODR_PWD=OdrLab2026x
# PDB holding the corpus.
ODR_PDB=FREEPDB1
